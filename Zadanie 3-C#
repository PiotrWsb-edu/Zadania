using System;
class Program
{
  static void Main()
  {
    Console.Write("Podaj liczbę ocen, które chcesz wprowadzić: ");
    int liczbaOcen = int.Parse(Console.ReadLine());
    double sumaOcen = 0;
    for (int i = 0; i < liczbaOcen; i++)
    {
      Console.Write($"Podaj ocenę {i + 1} (w skali 1-6): ");
      double ocena = double.Parse(Console.ReadLine());
      sumaOcen += ocena;
    }
    double srednia = sumaOcen / liczbaOcen;
    Console.WriteLine($"Średnia: {srednia:F2}");
    if (srednia >= 3.0)
    {
      Console.WriteLine("Uczeń zdał.");
    }
    else
    {
      Console.WriteLine("Uczeń nie zdał.");
    }
  }
}
